[Desktop Entry]
Type=Application
Name=Substance Version Tool
GenericName=Painter project converter
Comment=Make Substance 3D Painter projects open in an older Painter release
Exec=substance-version-tool --open %f
Icon=substance-version-tool
Terminal=false
Categories=Graphics;3DGraphics;
MimeType=application/x-substance-painter-project;
StartupWMClass=substance-version-tool
