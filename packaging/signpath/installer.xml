<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "installer": paste into the SignPath project under this
     slug. Input: the GitHub artifact "windows-setup-unsigned", which holds the Inno Setup
     installer (built from the already signed app) renamed to setup.exe. The installer's
     version resource is set in packaging/windows/substance-version-tool.iss. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="setup.exe"
             product-name="Substance Version Tool" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
