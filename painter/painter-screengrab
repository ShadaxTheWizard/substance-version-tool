#!/bin/sh
# Take a screenshot into the file "$1" (used by the eyedropper shim, see
# screengrab_shim.cpp). "$2" names the screen (output) wanted, e.g. DP-1. The
# image shows that screen or, where only that is on offer, the whole desktop;
# the shim tells the two apart. Any format Qt reads from the content will do
# (PNG, PPM); the file name is not a guide to it. Exits non-zero if no
# screenshot could be taken.
out="$1"
screen="${2:-}"
[ -n "$out" ] || exit 2
rm -f "$out"

# KDE Plasma: the one output, in its native pixels, straight from KWin
# (kwin_screengrab.cpp; install.sh builds and registers it).
if [ -n "$screen" ] && [ -x "${PAINTER_KWIN_SCREENGRAB:-}" ] \
        && "$PAINTER_KWIN_SCREENGRAB" "$out" "$screen" 2>/dev/null && [ -s "$out" ]; then
    exit 0
fi
rm -f "$out"

# wlroots compositors (and niri builds with screencopy): the whole desktop.
if command -v grim >/dev/null 2>&1 && grim -t ppm "$out" 2>/dev/null && [ -s "$out" ]; then
    exit 0
fi
rm -f "$out"

command -v niri >/dev/null 2>&1 || exit 1

# niri's screenshot action also puts the image on the clipboard; keep a text
# clipboard so that picking a colour does not wipe what was copied.
saved=""
if command -v wl-paste >/dev/null 2>&1 && command -v wl-copy >/dev/null 2>&1 \
        && wl-paste -l 2>/dev/null | grep -q '^text/plain'; then
    saved="$out.clip"
    wl-paste -n >"$saved" 2>/dev/null || { rm -f "$saved"; saved=""; }
fi

niri msg action screenshot-screen --write-to-disk true --show-pointer false --path "$out" || exit 1

# The file is written asynchronously: wait for the PNG end marker (up to 5 s).
status=1
i=0
while [ "$i" -lt 100 ]; do
    if [ -s "$out" ] && [ "$(tail -c 8 "$out" | od -An -tx1 | tr -d ' \n')" = "49454e44ae426082" ]; then
        status=0
        break
    fi
    sleep 0.05
    i=$((i + 1))
done

if [ -n "$saved" ]; then
    sleep 0.1
    wl-copy <"$saved"
    rm -f "$saved"
fi
exit $status
